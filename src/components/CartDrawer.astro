---
import settings from '../data/settings.json';

const { negocio, atendimento } = settings;
---

<div id="cart-drawer-root" class="cart-drawer-overlay" aria-hidden="true">
  <div class="cart-backdrop" data-close-cart></div>

  <section 
    class="cart-sheet" 
    role="dialog" 
    aria-modal="true" 
    aria-labelledby="cart-title"
    tabindex="-1"
  >
    <!-- Indicador de Arraste (Pílula Mobile - iOS Style) -->
    <div class="cart-drag-handle-wrap" id="cart-drag-area">
      <div class="cart-drag-handle"></div>
    </div>

    <!-- Cabeçalho do Drawer -->
    <header class="cart-header">
      <div class="cart-header-title-wrap">
        <span class="cart-header-icon">🛍️</span>
        <div>
          <h2 id="cart-title" class="cart-title">Sua Sacola</h2>
          <span class="cart-store-name">{negocio.nome}</span>
        </div>
      </div>
      <button 
        type="button" 
        class="cart-close-btn" 
        data-close-cart 
        aria-label="Fechar sacola"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <!-- Alerta Condicional: Restaurante Fechado (Opção A) -->
    <div id="cart-closed-notice" class="cart-closed-banner" style="display: none;">
      <span class="banner-icon">⚠️</span>
      <div class="banner-text">
        <strong>Estabelecimento fechado no momento</strong>
        <p>Você pode enviar seu pedido para agendamento no WhatsApp.</p>
      </div>
    </div>

    <!-- Conteúdo Scrollável dos Itens -->
    <div class="cart-body no-scrollbar">
      <!-- Estado Vazio -->
      <div id="cart-empty-state" class="cart-empty">
        <div class="empty-icon-wrap">🛒</div>
        <h3>Sua sacola está vazia</h3>
        <p>Explore as deliciosas esfihas e adicione itens para montar seu pedido!</p>
        <button type="button" id="btn-restore-last-order" class="btn-restore-last-order" style="display: none;">
          Repetir último pedido
        </button>
        <button type="button" class="btn-explore" data-close-cart>
          Explorar Cardápio
        </button>
      </div>

      <!-- Lista de Itens -->
      <div id="cart-items-container" class="cart-items-list" style="display: none;">
        <!-- Injetado dinamicamente pelo script -->
      </div>

      <!-- Formulário de Finalização -->
      <form id="cart-checkout-form" class="checkout-form" style="display: none;">
        <!-- Modalidade de Entrega -->
        <fieldset class="form-group">
          <legend class="form-label">Modalidade do Pedido</legend>
          <div class="radio-pill-group">
            <label class="radio-pill">
              <input type="radio" name="tipo_entrega" value="delivery" checked />
              <span class="pill-content">
                <span>🛵</span> Delivery
              </span>
            </label>
            <label class="radio-pill">
              <input type="radio" name="tipo_entrega" value="retirada" />
              <span class="pill-content">
                <span>🥡</span> Retirada
              </span>
            </label>
          </div>
        </fieldset>

        <!-- Nome do Cliente -->
        <div class="form-group">
          <label for="cliente-nome" class="form-label">
            Seu Nome <span class="required-star">*</span>
          </label>
          <input 
            type="text" 
            id="cliente-nome" 
            name="nome_cliente" 
            class="form-input" 
            placeholder="Como podemos te chamar?" 
            required 
            maxlength="60"
            autocomplete="name"
            enterkeyhint="next"
          />
          <span class="form-error" id="err-nome">Por favor, informe seu nome.</span>
        </div>

        <!-- Endereço de Entrega (Obrigatório para Delivery) -->
        <div id="endereco-wrapper" class="form-group">
          <label for="cliente-endereco" class="form-label">
            Endereço Completo de Entrega <span class="required-star">*</span>
          </label>
          <input 
            type="text" 
            id="cliente-endereco" 
            name="endereco_cliente" 
            class="form-input" 
            placeholder="Rua, Número, Bairro, Apto/Complemento" 
            maxlength="150"
            autocomplete="street-address"
            enterkeyhint="done"
          />
          <span class="form-error" id="err-endereco">O endereço é obrigatório para entrega.</span>
        </div>

        <!-- Forma de Pagamento -->
        <fieldset class="form-group">
          <legend class="form-label">Forma de Pagamento</legend>
          <div class="payment-grid">
            <label class="payment-card">
              <input type="radio" name="forma_pagamento" value="pix" checked />
              <span class="payment-content">
                <span class="payment-icon">⚡</span>
                <span class="payment-title">Pix</span>
                <span class="payment-badge">5% OFF</span>
              </span>
            </label>

            <label class="payment-card">
              <input type="radio" name="forma_pagamento" value="cartao_credito" />
              <span class="payment-content">
                <span class="payment-icon">💳</span>
                <span class="payment-title">Crédito</span>
              </span>
            </label>

            <label class="payment-card">
              <input type="radio" name="forma_pagamento" value="cartao_debito" />
              <span class="payment-content">
                <span class="payment-icon">💳</span>
                <span class="payment-title">Débito</span>
              </span>
            </label>

            <label class="payment-card">
              <input type="radio" name="forma_pagamento" value="dinheiro" />
              <span class="payment-content">
                <span class="payment-icon">💵</span>
                <span class="payment-title">Dinheiro</span>
              </span>
            </label>
          </div>
        </fieldset>

        <!-- Campo Troco (Condicional a Dinheiro) -->
        <div id="troco-wrapper" class="form-group" style="display: none;">
          <label for="troco-valor" class="form-label">Precisa de troco para quanto?</label>
          <input 
            type="text" 
            id="troco-valor" 
            name="troco_para" 
            class="form-input" 
            placeholder="Ex: R$ 50,00 ou Não preciso de troco"
          />
        </div>

        <!-- Observações Gerais do Pedido -->
        <div class="form-group">
          <label for="pedido-obs" class="form-label">Observações adicionais (opcional)</label>
          <textarea 
            id="pedido-obs" 
            name="observacao_geral" 
            class="form-input form-textarea" 
            rows="2" 
            placeholder="Ex: Tocar campainha, talheres descartáveis..."
            maxlength="200"
          ></textarea>
        </div>
      </form>
    </div>

    <!-- Rodapé Fixo da Sacola -->
    <footer id="cart-footer" class="cart-footer" style="display: none;">
      <div class="cart-summary-line">
        <span class="summary-label">Subtotal</span>
        <span id="cart-subtotal" class="summary-value">R$ 0,00</span>
      </div>
      <div class="cart-delivery-note">
        <span>🛵 Taxa de entrega calculada no WhatsApp</span>
      </div>

      <button 
        type="button" 
        id="btn-submit-order" 
        class="btn-checkout-whatsapp"
        aria-label="Enviar pedido estruturado pelo WhatsApp"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.9c0 2.1.55 4.06 1.6 5.83L2 22l4.4-1.15a9.86 9.86 0 0 0 5.64 1.72c5.46 0 9.9-4.45 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Z"/>
        </svg>
        <span>Enviar Pedido no WhatsApp</span>
      </button>
    </footer>
  </section>
</div>

<style>
  .cart-drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    justify-content: flex-end;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .cart-drawer-overlay.is-open {
    visibility: visible;
    opacity: 1;
  }

  .cart-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .cart-sheet {
    position: relative;
    width: 100%;
    max-width: 480px;
    height: 100%;
    max-height: 100dvh;
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.6);
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
  }

  @media (max-width: 640px) {
    .cart-drawer-overlay {
      align-items: flex-end;
      justify-content: stretch;
    }

    .cart-sheet {
      max-width: 100%;
      height: 90dvh;
      max-height: 90dvh;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      transform: translateY(100%);
    }
  }

  .cart-drawer-overlay.is-open .cart-sheet {
    transform: translate(0, 0);
  }

  /* Indicador visual de arraste (iOS Sheet Style) */
  .cart-drag-handle-wrap {
    display: none;
    width: 100%;
    padding: 0.6rem 0 0.2rem 0;
    justify-content: center;
    background-color: var(--color-surface-card);
    touch-action: none;
    cursor: grab;
  }

  .cart-drag-handle {
    width: 40px;
    height: 4.5px;
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.25);
    transition: background-color var(--transition-fast);
  }

  @media (max-width: 640px) {
    .cart-drag-handle-wrap {
      display: flex;
    }
  }

  /* Header */
  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background-color: var(--color-surface-card);
  }

  .cart-header-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .cart-header-icon {
    font-size: 1.4rem;
  }

  .cart-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.2;
  }

  .cart-store-name {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .cart-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--color-text-muted);
    transition: all var(--transition-fast);
  }

  .cart-close-btn:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.16);
  }

  /* Aviso de Fechado */
  .cart-closed-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.75rem 1.15rem;
    background-color: rgba(251, 191, 36, 0.12);
    border-bottom: 1px solid rgba(251, 191, 36, 0.25);
    color: #fde68a;
    font-size: 0.78rem;
  }

  .banner-icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  .banner-text strong {
    display: block;
    color: #fbbf24;
    font-weight: 700;
  }

  .banner-text p {
    margin-top: 0.15rem;
    line-height: 1.35;
  }

  /* Body */
  .cart-body {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Estado Vazio */
  .cart-empty {
    margin: auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2.5rem 1rem;
    gap: 0.75rem;
  }

  .empty-icon-wrap {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .cart-empty h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }

  .cart-empty p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    max-width: 280px;
    margin: 0;
    line-height: 1.45;
  }

  .btn-explore {
    display: inline-block;
    background-color: var(--color-primary);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.7rem 1.5rem;
    border-radius: var(--radius-full);
    transition: transform var(--transition-fast);
  }

  .btn-restore-last-order {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.85rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .btn-restore-last-order:hover {
    background-color: rgba(255, 107, 0, 0.08);
    transform: scale(1.02);
  }

  .btn-explore:hover {
    transform: scale(1.03);
  }

  /* Lista de Itens */
  .cart-items-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  :global(.cart-item-row) {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    background-color: var(--color-surface-card);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    gap: 0.5rem;
  }

  :global(.cart-item-main) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  :global(.cart-item-info) {
    flex: 1;
    min-width: 0;
  }

  :global(.cart-item-name) {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.cart-item-price) {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--color-primary);
    margin-top: 0.15rem;
  }

  :global(.cart-item-stepper) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    padding: 0.15rem 0.3rem;
  }

  :global(.cart-item-stepper button) {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(246, 96, 24, 0.2);
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 700;
  }

  :global(.cart-item-stepper .cart-item-minus.is-trash) {
    color: #ef4444;
    background-color: rgba(239, 68, 68, 0.15);
  }

  :global(.cart-item-qty) {
    min-width: 18px;
    text-align: center;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text);
  }

  :global(.cart-item-obs-input) {
    width: 100%;
    min-height: 4.5rem;
    resize: vertical;
    background-color: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: 0.75rem;
    line-height: 1.35;
    padding: 0.35rem 0.6rem;
  }

  :global(.cart-item-obs-input:focus) {
    outline: none;
    border-color: var(--color-primary);
  }

  /* Form */
  .checkout-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border: none;
    padding: 0;
    margin: 0;
  }

  .form-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .required-star {
    color: var(--color-primary);
  }

  .form-input {
    width: 100%;
    background-color: var(--color-surface-card);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: 0.85rem;
    padding: 0.65rem 0.85rem;
    transition: border-color var(--transition-fast);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .form-input.has-error {
    border-color: #ef4444;
  }

  .form-error {
    display: none;
    color: #ef4444;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .form-error.is-visible {
    display: block;
  }

  .form-textarea {
    resize: none;
  }

  /* Radio Pills para Entrega */
  .radio-pill-group {
    display: flex;
    gap: 0.5rem;
  }

  .radio-pill {
    flex: 1;
    cursor: pointer;
  }

  .radio-pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .pill-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.6rem 0.85rem;
    background-color: var(--color-surface-card);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-muted);
    transition: all var(--transition-fast);
  }

  .radio-pill input:checked + .pill-content {
    background-color: rgba(246, 96, 24, 0.15);
    border-color: var(--color-primary);
    color: var(--color-primary);
    font-weight: 700;
  }

  /* Grid de Pagamento */
  .payment-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .payment-card {
    cursor: pointer;
  }

  .payment-card input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .payment-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.4rem;
    background-color: var(--color-surface-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    gap: 0.2rem;
    transition: all var(--transition-fast);
    position: relative;
  }

  .payment-card input:checked + .payment-content {
    border-color: var(--color-primary);
    background-color: rgba(246, 96, 24, 0.12);
  }

  .payment-icon {
    font-size: 1.15rem;
  }

  .payment-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .payment-badge {
    position: absolute;
    top: -6px;
    right: -4px;
    background-color: var(--color-primary);
    color: #ffffff;
    font-size: 0.62rem;
    font-weight: 800;
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-full);
  }

  /* Footer */
  .cart-footer {
    padding: 1rem 1.25rem;
    background-color: var(--color-surface-card);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .cart-summary-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .summary-label {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .summary-value {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-primary);
  }

  .cart-delivery-note {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .btn-checkout-whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.85rem 1rem;
    background-color: var(--color-whatsapp);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 800;
    border-radius: var(--radius-full);
    box-shadow: 0 4px 14px rgba(0, 167, 76, 0.4);
    transition: all var(--transition-fast);
  }

  .btn-checkout-whatsapp:hover {
    background-color: var(--color-whatsapp-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 167, 76, 0.55);
  }
</style>
