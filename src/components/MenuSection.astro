---
import MenuCard from './MenuCard.astro';

interface Props {
  categoriaId: string;
  categoriaNome: string;
  categoriaIcone?: string;
  itens: Array<any>;
}

const { categoriaId, categoriaNome, categoriaIcone, itens } = Astro.props;
---

<section 
  class="menu-section" 
  id={`cat-${categoriaId}`}
  aria-labelledby={`heading-${categoriaId}`}
>
  <div class="section-header">
    <div class="header-left">
      {categoriaIcone && <span class="category-icon">{categoriaIcone}</span>}
      <h3 id={`heading-${categoriaId}`} class="section-title">
        {categoriaNome}
      </h3>
    </div>
    <span class="items-count">{itens.length} {itens.length === 1 ? 'item' : 'opções'}</span>
  </div>

  <div class="cards-grid">
    {itens.map((item) => (
      <MenuCard item={item} />
    ))}
  </div>
</section>

<style>
  .menu-section {
    margin-bottom: 2.25rem;
    scroll-margin-top: 5rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.95rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid rgba(255, 255, 255, 0.08);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .category-icon {
    font-size: 1.15rem;
  }

  .section-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .items-count {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 600px) {
    .cards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
