---
import settings from '../data/settings.json';

const { categorias } = settings;
---

<nav class="chips-container no-scrollbar" aria-label="Categorias do cardápio">
  <div class="chips-wrapper">
    {categorias.map((cat, index) => (
      <a
        href={`#cat-${cat.id}`}
        class:list={["category-chip", { active: index === 0 }]}
        data-cat-id={cat.id}
      >
        <span class="chip-icon">{cat.icone}</span>
        <span class="chip-text">{cat.nome}</span>
      </a>
    ))}
  </div>
</nav>

<script>
  function setupCategoryObserver() {
    const chips = document.querySelectorAll<HTMLAnchorElement>('.category-chip');
    if (!chips.length) return;

    const sections = Array.from(chips)
      .map((chip) => {
        const id = chip.getAttribute('href')?.replace('#', '');
        return id ? document.getElementById(id) : null;
      })
      .filter((s): s is HTMLElement => s !== null);

    if (!sections.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            chips.forEach((chip) => {
              const matches = chip.getAttribute('href') === `#${id}`;
              chip.classList.toggle('active', matches);
              if (matches) {
                chip.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
              }
            });
          }
        });
      },
      {
        rootMargin: '-20% 0px -70% 0px',
        threshold: 0,
      }
    );

    sections.forEach((sec) => observer.observe(sec));
  }

  // Inicializa quando o DOM estiver pronto
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCategoryObserver);
  } else {
    setupCategoryObserver();
  }
</script>

<style>
  .chips-container {
    position: sticky;
    top: 0;
    z-index: 30;
    margin: 0 -1rem 1.25rem -1rem;
    padding: 0.75rem 1rem;
    background: rgba(25, 18, 14, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .chips-wrapper {
    display: flex;
    gap: 0.5rem;
    width: max-content;
  }

  .category-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.08);
    white-space: nowrap;
    scroll-snap-align: start;
    transition: all var(--transition-fast);
  }

  .category-chip:hover {
    color: var(--color-text);
    border-color: rgba(246, 96, 24, 0.4);
  }

  .category-chip.active {
    background-color: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
    box-shadow: 0 2px 10px rgba(246, 96, 24, 0.4);
  }

  .chip-icon {
    font-size: 0.95rem;
  }
</style>
