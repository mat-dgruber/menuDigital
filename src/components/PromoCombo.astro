---
import settings from '../data/settings.json';

const { combo_destaque, atendimento } = settings;

if (!combo_destaque || !combo_destaque.ativo) {
  return null;
}

const precoDeFmt = `R$ ${combo_destaque.preco_de.toFixed(2).replace('.', ',')}`;
const precoPorFmt = `R$ ${combo_destaque.preco_por.toFixed(2).replace('.', ',')}`;

const msgCombo = `Olá! Gostaria de pedir o *${combo_destaque.titulo}* (${precoPorFmt}).`;
const waComboUrl = `https://wa.me/${atendimento.whatsapp}?text=${encodeURIComponent(msgCombo)}`;
---

<div class="promo-banner" id="cat-combos">
  <div class="promo-media">
    <img 
      src={combo_destaque.foto} 
      alt={combo_destaque.titulo} 
      class="promo-img" 
      loading="lazy"
    />
    <div class="promo-overlay"></div>
    <span class="badge badge-primary promo-tag">
      🔥 {combo_destaque.badge}
    </span>
  </div>

  <div class="promo-body">
    <div class="promo-header">
      <h3 class="promo-title">{combo_destaque.titulo}</h3>
      <span class="economy-tag">{combo_destaque.economia}</span>
    </div>

    <p class="promo-desc">{combo_destaque.descricao}</p>

    <div class="promo-footer">
      <div class="price-stack">
        <span class="price-from">De {precoDeFmt}</span>
        <span class="price-to">{precoPorFmt}</span>
      </div>

      <a 
        href={waComboUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="promo-btn"
        aria-label={`Pedir ${combo_destaque.titulo} pelo WhatsApp`}
      >
        <span>Pedir Combo</span>
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .promo-banner {
    background: linear-gradient(145deg, #2a1f18 0%, #1f1713 100%);
    border: 1px solid rgba(246, 96, 24, 0.35);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-glow);
  }

  .promo-media {
    position: relative;
    width: 100%;
    height: 150px;
    overflow: hidden;
  }

  .promo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .promo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(31, 23, 19, 0.95) 100%);
  }

  .promo-tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background-color: var(--color-primary);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .promo-body {
    padding: 1rem 1.15rem 1.25rem 1.15rem;
  }

  .promo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .promo-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .economy-tag {
    background-color: rgba(0, 167, 76, 0.18);
    color: #34d399;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(0, 167, 76, 0.3);
    white-space: nowrap;
  }

  .promo-desc {
    font-size: 0.83rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin-bottom: 1rem;
  }

  .promo-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 0.85rem;
  }

  .price-stack {
    display: flex;
    flex-direction: column;
  }

  .price-from {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .price-to {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-secondary);
    line-height: 1.1;
  }

  .promo-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background-color: var(--color-primary);
    color: #ffffff;
    padding: 0.65rem 1.15rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(246, 96, 24, 0.35);
    transition: all var(--transition-fast);
  }

  .promo-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(246, 96, 24, 0.5);
  }
</style>
