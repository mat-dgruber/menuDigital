---
import settings from '../data/settings.json';

interface Props {
  item: {
    data: {
      nome: string;
      descricao?: string;
      preco: number;
      categoria: string;
      foto?: string;
      destaque?: boolean;
      maisPedido?: boolean;
      disponivel?: boolean;
      ingredientes?: string[];
      tags?: string[];
    };
  };
}

const { item } = Astro.props;
const { nome, descricao, preco, foto, destaque, disponivel, ingredientes, tags } = item.data;
const { atendimento } = settings;

const itemId = item.id || nome.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '');
const precoFmt = `R$ ${preco.toFixed(2).replace('.', ',')}`;

// URL contextualizada do WhatsApp para o item específico
const msgItem = `Olá! Gostaria de pedir 1x *${nome}* (${precoFmt}).`;
const waItemUrl = `https://wa.me/${atendimento.whatsapp}?text=${encodeURIComponent(msgItem)}`;
---

<article class:list={["menu-card", { "menu-card--soldout": disponivel === false }]}>
  {foto && (
    <div class="card-media">
      <img 
        src={foto} 
        alt={nome} 
        class="card-img" 
        loading="lazy" 
        width="96" 
        height="96" 
      />
      {destaque && (
        <span class="card-star-badge" title="Destaque do Chef" role="img" aria-label="Item em destaque do chef">
          ⭐
        </span>
      )}
    </div>
  )}

  <div class="card-content">
    <div class="card-header">
      <h4 class="card-title">
        {nome}
      </h4>
      <span class="card-price">{precoFmt}</span>
    </div>

    {descricao && <p class="card-desc">{descricao}</p>}

    {ingredientes && ingredientes.length > 0 && (
      <details class="card-details">
        <summary>Ver ingredientes</summary>
        <p>{ingredientes.join(', ')}</p>
      </details>
    )}

    {tags && tags.length > 0 && (
      <div class="card-tags">
        {tags.map((t) => (
          <span class="tag-pill">{t}</span>
        ))}
      </div>
    )}

    <div class="card-actions">
      {disponivel === false ? (
        <span class="soldout-label">Esgotado por hoje</span>
      ) : (
        <div
          class="card-cart-controls"
          data-cart-control
          data-item-id={itemId}
          data-item-nome={nome}
          data-item-preco={preco}
          data-item-foto={foto || ''}
        >
          <button
            type="button"
            class="add-to-cart-btn"
            aria-label={`Adicionar ${nome} à sacola por ${precoFmt}`}
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Adicionar</span>
          </button>

          <div class="qty-stepper" style="display: none;">
            <button type="button" class="qty-btn qty-btn--minus" aria-label={`Diminuir quantidade de ${nome}`}>
              <span class="qty-minus-icon">−</span>
            </button>
            <span class="qty-display" aria-live="polite">1</span>
            <button type="button" class="qty-btn qty-btn--plus" aria-label={`Aumentar quantidade de ${nome}`}>+</button>
          </div>
        </div>
      )}
    </div>
  </div>
</article>

<style>
  .menu-card {
    display: flex;
    gap: 0.85rem;
    padding: 0.85rem;
    background-color: var(--color-surface-card);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-md);
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }

  .menu-card:hover {
    border-color: rgba(246, 96, 24, 0.4);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .menu-card--soldout {
    opacity: 0.5;
    filter: grayscale(0.8);
  }

  .card-media {
    position: relative;
    width: 96px;
    height: 96px;
    border-radius: var(--radius-md);
    overflow: hidden;
    flex-shrink: 0;
    background-color: var(--color-surface);
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.02) 25%, rgba(255, 255, 255, 0.06) 50%, rgba(255, 255, 255, 0.02) 75%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite ease-in-out;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: relative;
    z-index: 1;
  }

  .card-star-badge {
    position: absolute;
    top: 0.35rem;
    left: 0.35rem;
    background-color: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    padding: 0.15rem 0.35rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    line-height: 1;
  }

  .card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }

  .card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .card-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.25;
  }

  .card-price {
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-primary);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .card-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin-bottom: 0.45rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-details {
    margin-bottom: 0.5rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    interpolate-size: allow-keywords;
  }

  .card-details::details-content {
    block-size: 0;
    opacity: 0;
    overflow: clip;
    transition:
      block-size var(--transition-normal),
      opacity var(--transition-fast),
      content-visibility var(--transition-normal) allow-discrete;
  }

  .card-details[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  @starting-style {
    .card-details[open]::details-content {
      block-size: 0;
      opacity: 0;
    }
  }

  .card-details summary {
    width: fit-content;
    min-height: 32px;
    display: flex;
    align-items: center;
    color: var(--color-primary);
    font-weight: 700;
    cursor: pointer;
  }

  .card-details p {
    margin-top: 0.2rem;
    line-height: 1.4;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.5rem;
  }

  .tag-pill {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background-color: rgba(255, 255, 255, 0.05);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .card-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: auto;
  }

  .card-cart-controls {
    display: flex;
    align-items: center;
  }

  .add-to-cart-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: rgba(246, 96, 24, 0.15);
    color: var(--color-primary);
    border: 1px solid rgba(246, 96, 24, 0.35);
    padding: 0.5rem 0.85rem;
    min-height: 42px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 700;
    transition: all var(--transition-fast);
  }

  .add-to-cart-btn:hover {
    background-color: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
    transform: scale(1.02);
  }

  .qty-stepper {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background-color: var(--color-surface);
    border: 1px solid rgba(246, 96, 24, 0.4);
    border-radius: var(--radius-full);
    padding: 0.2rem 0.35rem;
    min-height: 42px;
  }

  .qty-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background-color: rgba(246, 96, 24, 0.2);
    color: var(--color-primary);
    font-weight: 800;
    font-size: 0.95rem;
    transition: all var(--transition-fast);
  }

  .qty-btn:hover {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .qty-btn--minus.is-trash {
    color: #ef4444;
    background-color: rgba(239, 68, 68, 0.15);
  }

  .qty-btn--minus.is-trash:hover {
    background-color: #ef4444;
    color: #ffffff;
  }

  .qty-display {
    min-width: 22px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  .soldout-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
</style>
